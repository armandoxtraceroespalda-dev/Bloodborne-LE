<Project DefaultTargets="Build">
  <!-- Compatibility entry point: only the native launcher project is built. -->
  <PropertyGroup><NativeProject>$(MSBuildThisFileDirectory)../BloodborneLauncher.Native/BloodborneLauncher.Native.csproj</NativeProject></PropertyGroup>
  <Target Name="Restore"><MSBuild Projects="$(NativeProject)" Targets="Restore" /></Target>
  <Target Name="Build"><MSBuild Projects="$(NativeProject)" Targets="Build" /></Target>
  <Target Name="Publish"><MSBuild Projects="$(NativeProject)" Targets="Publish" /></Target>
  <Target Name="Clean"><MSBuild Projects="$(NativeProject)" Targets="Clean" /></Target>
  <Target Name="Rebuild"><MSBuild Projects="$(NativeProject)" Targets="Rebuild" /></Target>
</Project>
