<Window x:Class="BloodborneLauncher.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:BloodborneLauncher.Controls"
                 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                 xmlns:core="clr-namespace:BloodborneLauncher.Core"
                 xmlns:views="clr-namespace:BloodborneLauncher.Views"
                 Title="Bloodborne Launcher"
                 Icon="app.ico"
                 Height="800" Width="1280"
                 MinHeight="620" MinWidth="900"
                 WindowStartupLocation="CenterScreen"
                 
                 
                 
                 WindowStyle="None" BorderThickness="0"
                 Background="{DynamicResource WindowBaseBrush}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <Style x:Key="TitleIcon" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <!-- WPF-UI's implicit button style paints a light fill; these sit on the dark title bar. -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="7,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowsCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#FF343638" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBackground" Property="Background" Value="#FF4A4C4E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowsCloseButton" TargetType="Button" BasedOn="{StaticResource WindowsCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBackground" Property="Background" Value="#FFC42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBackground" Property="Background" Value="#FFA52116" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Image x:Name="BackdropImage" Grid.RowSpan="4" Stretch="UniformToFill" IsHitTestVisible="False" />
        <Rectangle x:Name="SettingsShade" Grid.RowSpan="4" Fill="#99000000" Visibility="Collapsed" IsHitTestVisible="False" />
        <Rectangle x:Name="BackdropShade" Grid.RowSpan="4" Fill="#A6000000" IsHitTestVisible="False" />
        <Border Grid.Row="1" Panel.ZIndex="10" Height="34" VerticalAlignment="Top" Background="Transparent">
            <Grid>
                <StackPanel x:Name="WindowsCaptionButtons" core:MenuSounds.IsSoundEnabled="False" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="Visible" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource WindowsCaptionButton}" Content="&#xE921;" ToolTip="{core:Loc Minimize}" Click="MinimizeWindow_Click" />
                    <Button x:Name="WindowsMaximize" Style="{StaticResource WindowsCaptionButton}" Content="&#xE922;" ToolTip="{core:Loc Maximize}" Click="MaximizeWindow_Click" />
                    <Button Style="{StaticResource WindowsCloseButton}" Content="&#xE8BB;" ToolTip="{core:Loc Close}" Click="CloseWindow_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <views:MenuSurface x:Name="SidebarHost" Panel.ZIndex="5" Framed="False" ShadowOpacity="0" Background="Transparent" Padding="0,26,0,26">
                <!-- All navigation rows fit at the supported minimum window size.
                     Avoid a scroll viewport that clips the glow's horizontal wings. -->
                <Grid x:Name="SidebarItems" MinHeight="480" ClipToBounds="False" />
            </views:MenuSurface>
            <views:MenuBookHost x:Name="BookHost" Grid.Column="1" Active="False" ClipToBounds="True"
                                ArtOpacity="{Binding Opacity,ElementName=PageFrame}">
                <views:MenuBookHost.Style>
                    <Style TargetType="{x:Type views:MenuBookHost}">
                        <Setter Property="Margin" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="Active" Value="True">
                                <Setter Property="Margin" Value="-16,0,0,0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </views:MenuBookHost.Style>
                <ContentControl x:Name="PageFrame" Focusable="False" ClipToBounds="False" Background="Transparent"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </views:MenuBookHost>
        </Grid>
        <Button x:Name="AudioToggle" Grid.Row="1" Panel.ZIndex="20" Width="34" Height="32"
                Margin="0,0,12,10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                core:MenuSounds.IsSoundEnabled="False" Click="AudioToggle_Click"
                Style="{StaticResource TitleIcon}" ToolTip="{core:Loc Mute launcher sounds}" Padding="0">
            <Grid Width="20" Height="18" IsHitTestVisible="False">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      Data="M 1,6 L 5,6 L 10,2 L 10,16 L 5,12 L 1,12 Z" />
                <Path x:Name="AudioWaves" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" Data="M 12,5 Q 16,9 12,13 M 15,2 Q 22,9 15,16" />
                <Path x:Name="AudioMutedMark" Visibility="Collapsed"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" Data="M 13,6 L 19,12 M 19,6 L 13,12" />
            </Grid>
        </Button>
    </Grid>
</Window>
