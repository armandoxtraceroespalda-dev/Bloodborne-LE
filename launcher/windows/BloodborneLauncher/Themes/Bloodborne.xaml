<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:BloodborneLauncher.Controls"
                    xmlns:views="clr-namespace:BloodborneLauncher.Views">

    

    
    <SolidColorBrush x:Key="WindowBaseBrush" Color="#FF0C0E10" />
    <SolidColorBrush x:Key="ContentAreaBrush" Color="#CC111315" />

    
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FF191B1C" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF151719" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF555957" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF555957" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF242725" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF2C302B" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF1D211F" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FF101315" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF737875" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF444947" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#FF2B2B2E" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FF35372C" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FF242820" />

    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF161A1A" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF101415" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#FF161A1A" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorDefaultBrush" Color="#FF161A1A" />
    <SolidColorBrush x:Key="AcrylicBackgroundFillColorBaseBrush" Color="#FF101415" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF101415" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FF161A1A" />

    
    <SolidColorBrush x:Key="PanelDeepBrush" Color="#FF0B0D0F" />

    
    <SolidColorBrush x:Key="DialogScrimBrush" Color="#99000000" />
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#FF181A1B" />
    <SolidColorBrush x:Key="DialogStrokeBrush" Color="#FF707672" />

    
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="#FF373329" />
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#FF272820" />
    <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#FF9F957E" />

    
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE3DDCB" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFC8B48A" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FFAD9A72" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFD4C49D" />
    <SolidColorBrush x:Key="StatusDotIdleBrush" Color="#FF827E70" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFD4B579" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFCE887B" />
    <SolidColorBrush x:Key="GoodTextBrush" Color="#FFBBC09B" />
    
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FF4B4130" />

    
    <SolidColorBrush x:Key="GlassPaneBrush" Color="#FF191B1C" />
    <SolidColorBrush x:Key="GlassPaneStrokeBrush" Color="#FF636A66" />
    <SolidColorBrush x:Key="GlassDividerBrush" Color="#FF353A38" />
    <SolidColorBrush x:Key="PillTrackBrush" Color="#FF101214" />

    
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>


    <!-- Shared native artwork, frozen brushes and lightweight entry transitions. -->
    <FontFamily x:Key="BloodborneFont">Palatino Linotype, Georgia, Times New Roman</FontFamily>
    <LinearGradientBrush x:Key="BloodbornePanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF202323" Offset="0" />
        <GradientStop Color="#FF151819" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BloodborneSelectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#004F4938" Offset="0" />
        <GradientStop Color="#AA665C42" Offset="0.5" />
        <GradientStop Color="#004F4938" Offset="1" />
    </LinearGradientBrush>
    <DrawingBrush x:Key="BloodborneGrainBrush" TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#021F292B" Geometry="M0,0 H48 V48 H0 Z" />
                <GeometryDrawing Brush="#09C6B991" Geometry="M3,7 H4 V8 H3 Z M19,31 H20 V32 H19 Z M37,14 H38 V15 H37 Z" />
                <GeometryDrawing Brush="#19000000" Geometry="M7,19 H33 V19.4 H7 Z M24,41 H44 V41.4 H24 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="SectionHeadingBrush" Color="#FFD7D8D5" />
    <Style x:Key="GroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BloodborneFont}" />
        <Setter Property="FontSize" Value="21.875" />
        <Setter Property="Foreground" Value="#FFD7D8D5" />
        <Setter Property="Margin" Value="4,24,0,10" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BloodborneFont}" />
        <Setter Property="FontSize" Value="18.375" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource BloodborneFont}" />
        <Setter Property="FontSize" Value="13.125" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColorSecondaryBrush}" />
    </Style>
    <SolidColorBrush x:Key="SliderActiveGoldBrush" Color="#FFB3A072" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF62583D" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF514A35" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF413C2D" />
    <!-- Fallback drawings are replaced by the user's original exported game atlases. -->
    <SolidColorBrush x:Key="MenuGlowBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MenuFrameBrush" Color="Transparent" />
    <SolidColorBrush x:Key="MenuUnderlineBrush" Color="Transparent" />
    <LinearGradientBrush x:Key="MenuGlowHalfBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#006E5721" Offset="0" />
        <GradientStop Color="#707C6225" Offset="0.75" />
        <GradientStop Color="#C0CFA655" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="BloodborneSidebarButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource BloodborneFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="22.75" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
                <views:MenuTabSurface x:Name="TabSurface" IsHitTestVisible="False" Underline="{Binding Path=(views:MenuTabSurface.ShowUnderline), RelativeSource={RelativeSource TemplatedParent}}"
                    CaptionWidth="{Binding ActualWidth,ElementName=Caption}" CaptionHeight="{Binding ActualHeight,ElementName=Caption}" />
                <ContentPresenter x:Name="Caption" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Highlight" Value="True" /><Setter Property="Foreground" Value="White" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="Highlight" Value="True" /></Trigger>
                <Trigger Property="Tag" Value="active"><Setter TargetName="TabSurface" Property="Highlight" Value="True" /><Setter Property="Foreground" Value="White" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BloodbornePlayButton" TargetType="Button" BasedOn="{StaticResource BloodborneSidebarButton}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="50.75" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <views:MenuTabSurface x:Name="PlaySurface" IsHitTestVisible="False"
                        CaptionWidth="{Binding ActualWidth,ElementName=PlayCaption}" CaptionHeight="{Binding ActualHeight,ElementName=PlayCaption}" />
                    <ContentPresenter x:Name="PlayCaption" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PlaySurface" Property="Highlight" Value="True" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PlaySurface" Property="Highlight" Value="True" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="BloodborneActionButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource BloodborneFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="18.375" /><Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,6" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Button"><Grid Background="Transparent">
                <views:MenuControlFrame x:Name="Trim" IsHitTestVisible="False" />
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Grid><ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Trim" Property="Highlight" Value="True" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Trim" Property="Highlight" Value="True" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers></ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BloodborneActionButton}" />
    <Style TargetType="ui:Button" BasedOn="{StaticResource BloodborneActionButton}">
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ui:Button"><Grid Background="Transparent">
                <views:MenuControlFrame x:Name="Trim" IsHitTestVisible="False" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="ActionIcon" Content="{TemplateBinding Icon}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" TextBlock.TextAlignment="Center" RecognizesAccessKey="True" />
                </StackPanel>
            </Grid><ControlTemplate.Triggers>
                <Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="ActionIcon" Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Trim" Property="Highlight" Value="True" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Trim" Property="Highlight" Value="True" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers></ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="Padding" Value="12,7" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem"><Grid Background="Transparent">
                <views:MenuControlFrame x:Name="Trim" Visibility="Hidden" IsHitTestVisible="False" Highlight="True" />
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center" />
            </Grid><ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Trim" Property="Visibility" Value="Visible" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentTextFillColorPrimaryBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers></ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource BloodborneFont}" /><Setter Property="FontSize" Value="18.375" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="MinHeight" Value="38" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ComboBox"><Grid>
                <ToggleButton Style="{x:Null}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent">
                        <views:MenuControlFrame x:Name="Trim" IsHitTestVisible="False" />
                        <TextBlock Text="⌄" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                    </Grid><ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Trim" Property="Highlight" Value="True" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Trim" Property="Highlight" Value="True" /></Trigger>
                    </ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="26,5,26,5" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextBlock.TextAlignment="Center" IsHitTestVisible="False" />
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="False" Focusable="False" PopupAnimation="None">
                    <Grid Background="#FF101213" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <views:MenuControlFrame IsHitTestVisible="False" />
                        <ScrollViewer Margin="4" CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                    </Grid>
                </Popup>
            </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="BloodborneSegmentButton" TargetType="Button" BasedOn="{StaticResource BloodborneActionButton}">
        <Setter Property="FontSize" Value="15.75" /><Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
                <views:MenuControlFrame x:Name="Trim" IsHitTestVisible="False" />
                <ContentPresenter Margin="14,7" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag" Value="active"><Setter TargetName="Trim" Property="Highlight" Value="True" /><Setter Property="Foreground" Value="White" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Trim" Property="Highlight" Value="True" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Trim" Property="Highlight" Value="True" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ui:ToggleSwitch">
        <Setter Property="FontFamily" Value="{DynamicResource BloodborneFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextFillColorPrimaryBrush}" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ui:ToggleSwitch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Grid Width="58" Height="34" Background="Transparent">
                        <Border CornerRadius="12" Height="24" Margin="4,0" Background="#FF141617" VerticalAlignment="Center" />
                        <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" Background="#FF505354"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0" />
                        <views:MenuSwitchGlow x:Name="KnobGlow" Width="58" Height="34" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="KnobGlow" Property="Active" Value="True" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="KnobGlow" Property="Active" Value="False" /><Setter Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="BloodborneSliderLine" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"><Rectangle Height="2" Fill="{StaticResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center" /></Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid Background="Transparent" Margin="3,0">
                <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                       Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource BloodborneSliderLine}" /></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource BloodborneSliderLine}" /></Track.IncreaseRepeatButton>
                    <Track.Thumb><Thumb x:Name="SliderThumb" Width="24" Height="20" Foreground="{StaticResource ControlStrokeColorDefaultBrush}"><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Grip" Width="21" Height="2" Fill="{TemplateBinding Foreground}" />
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Fill" Value="{StaticResource SliderActiveGoldBrush}" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Fill" Value="{StaticResource SliderActiveGoldBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
            </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SliderThumb" Property="Foreground" Value="{StaticResource SliderActiveGoldBrush}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

<Style TargetType="ui:Card"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ui:Card"><views:MenuSurface Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}"/></views:MenuSurface></ControlTemplate></Setter.Value></Setter></Style>

    <!-- Dark native scrolling: retain drag, line, page and horizontal behavior without white system chrome. -->
    <SolidColorBrush x:Key="ScrollRailBrush" Color="#FF17191B" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF494C4F" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF626568" />
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#FF777A7D" />
    <SolidColorBrush x:Key="ScrollArrowBrush" Color="#FF777A7D" />
    <Style x:Key="DarkScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{StaticResource ScrollThumbBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
            <Border Background="{TemplateBinding Background}" Margin="2" CornerRadius="3"/>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ScrollThumbHoverBrush}"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="{StaticResource ScrollThumbDragBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DarkScrollButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
            <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></Style.Triggers>
    </Style>
    <ControlTemplate x:Key="DarkVerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="{StaticResource ScrollRailBrush}">
            <Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/></Grid.RowDefinitions>
            <RepeatButton Style="{StaticResource DarkScrollButton}" Command="{x:Static ScrollBar.LineUpCommand}"><Path Width="6" Height="3" Data="M0,3 L3,0 L6,3 Z" Fill="{StaticResource ScrollArrowBrush}"/></RepeatButton>
            <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True"
                Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource DarkScrollButton}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource DarkScrollThumb}" MinHeight="18"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource DarkScrollButton}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Style="{StaticResource DarkScrollButton}" Command="{x:Static ScrollBar.LineDownCommand}"><Path Width="6" Height="3" Data="M0,0 L3,3 L6,0 Z" Fill="{StaticResource ScrollArrowBrush}"/></RepeatButton>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="DarkHorizontalScrollBar" TargetType="ScrollBar">
        <Grid Background="{StaticResource ScrollRailBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
            <RepeatButton Style="{StaticResource DarkScrollButton}" Command="{x:Static ScrollBar.LineLeftCommand}"><Path Width="3" Height="6" Data="M3,0 L0,3 L3,6 Z" Fill="{StaticResource ScrollArrowBrush}"/></RepeatButton>
            <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal" IsDirectionReversed="False"
                Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource DarkScrollButton}" Command="{x:Static ScrollBar.PageLeftCommand}"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource DarkScrollThumb}" MinWidth="18"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource DarkScrollButton}" Command="{x:Static ScrollBar.PageRightCommand}"/></Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Style="{StaticResource DarkScrollButton}" Command="{x:Static ScrollBar.LineRightCommand}"><Path Width="3" Height="6" Data="M0,0 L3,3 L0,6 Z" Fill="{StaticResource ScrollArrowBrush}"/></RepeatButton>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="14"/><Setter Property="Template" Value="{StaticResource DarkVerticalScrollBar}"/>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/><Setter Property="Template" Value="{StaticResource DarkHorizontalScrollBar}"/>
        </Trigger></Style.Triggers>
    </Style>

</ResourceDictionary>
